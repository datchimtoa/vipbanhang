# ═══════════════════════════════════════════════
# TELE SHOP BOT — FILE CẤU HÌNH (.env)
# Sửa các giá trị bên dưới rồi khởi động lại bot
# ═══════════════ trên VPS ══════════════════════

# ── BẮT BUỘC ──
# Token từ @BotFather
BOT_TOKEN=1234567890:AAAA-your-bot-token-here
# ID admin (lấy bằng lệnh /id hoặc @userinfobot), nhiều admin cách nhau bởi dấu phẩy
ADMIN_IDS=123456789
# Username admin (không cần @) — chỉ dùng khi cần báo lỗi/kho, OTP lấy ngay tại bot
ADMIN_USERNAME=admin

# ── DATABASE ──
DB_FILE=tele_shop_vps.sqlite3

# ── NẠP QUA NGÂN HÀNG (VietQR — KHÔNG cần API autopay) ──
# BANK_ID: vietcombank|techcombank|mbbank|acb|vietinbank|bidv|sacombank|tpbank...
BANK_ID=techcombank
BANK_ACCOUNT_NO=0000000000
BANK_ACCOUNT_NAME=CHU TAI KHOAN

# ── NẠP USDT (BEP20) ──
# Ví BEP20 nhận USDT. Để trống sẽ ẩn kênh nạp này
USDT_BEP20_ADDRESS=

# ── NẠP GRAM (TON) ──
# Ví TON nhận. Để trống sẽ ẩn kênh nạp này
TON_ADDRESS=

# ── TỈ GIÁ QUY ĐỔI RA VND (admin đổi runtime bằng /setrate) ──
USDT_RATE_VND=25000
TON_RATE_VND=78000

# ── BÁN ACC SLL: giá riêng Acc Việt / Acc Ngoại ──
# Các gói bán, cách nhau bởi dấu phẩy (có thể tách riêng 2 loại)
PACK_SIZES_VN=10,20,50,100
PACK_SIZES_NGOAI=10,20,50,100
# Giá lẻ mặc định /1 acc từng loại (dùng khi seed gói lần đầu + giá acc lẻ)
PACK_PRICE_VN=50000
PACK_PRICE_NGOAI=80000
# Fallback nếu chưa set 2 biến trên (giữ tương thích cấu hình cũ)
PACK_PRICE_PER_ACC=50000

# ── TIẾP THỊ (AFFILIATE) ──
# % hoa hồng cho người giới thiệu trên mỗi đơn hàng của người được giới thiệu
AFF_PERCENT=5

# ── ACC: GỬI KÈM MK / 2FA (tuỳ chọn) ──
# 1 = giao acc + OTP có kèm MK/2FA (nếu acc có dữ liệu), 0 = chỉ gửi SĐT
# Đổi runtime bằng lệnh: /setaccinfo on|off
SHOW_ACC_INFO=1

# ── NẠP TIỀN ──
MIN_DEPOSIT_VND=10000
